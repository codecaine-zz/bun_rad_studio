# Required Homebrew dependencies for Bun RAD Studio
# Install with: brew bundle --file ./Brewfile
# Or run: ./install_homebrew_dependencies.sh
#
# Optional Windows/Linux cross-compilation toolchains are kept in Brewfile.optional.

# Media, Audio & Graphics
brew "ffmpeg"
brew "imagemagick"
brew "yt-dlp"
brew "exiftool"
brew "tesseract"
brew "graphviz"

# Text, Data & Document Processing
brew "jq"
brew "yq"
brew "pandoc"
brew "gawk"
brew "sd"

# Search, Navigation & Modern CLI
brew "ripgrep"
brew "fd"
brew "eza"
brew "bat"
brew "watchexec"
brew "ouch"
brew "rip2"

# Database, Network & Security
brew "sqlite"
brew "wget2"
brew "nmap"
brew "bind"
brew "openssl@3"
brew "whois"
brew "subfinder"
brew "qrencode"

# Mathematics & Scientific Calculators
brew "libqalculate"
brew "numbat"
brew "kalker"
